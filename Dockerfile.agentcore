# Amazon Bedrock AgentCore requires linux/arm64.
FROM --platform=linux/arm64 python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AGENTCORE_RUNTIME=1 \
    RENDERHAUS_MEDIA_DIR=/tmp/renderhaus/media \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY pyproject.toml README.md ./
COPY agent ./agent
COPY providers ./providers
COPY configs ./configs
COPY server ./server

# openai-codex installs the pinned native Codex runtime for linux/arm64.
RUN pip install --no-cache-dir -e . \
    && python -c "import subprocess; from codex_cli_bin import bundled_codex_path; subprocess.run([str(bundled_codex_path()), '--version'], check=True)"

EXPOSE 8080

CMD ["python", "-m", "agent.studio_agent_next"]
