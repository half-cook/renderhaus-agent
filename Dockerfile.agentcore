# Amazon Bedrock AgentCore requires linux/arm64.
FROM --platform=linux/arm64 python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AGENTCORE_RUNTIME=1 \
    RENDERHAUS_AGENT_BACKEND=codex \
    RENDERHAUS_MEDIA_DIR=/tmp/renderhaus/media \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY pyproject.toml README.md THIRD_PARTY_NOTICES ./
COPY agent ./agent
COPY providers ./providers
COPY configs ./configs
COPY tests/fixtures/skill_routing.json ./tests/fixtures/
COPY server ./server
COPY third_party ./third_party

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg bubblewrap nodejs npm chromium \
    && rm -rf /var/lib/apt/lists/*

COPY remotion/package.json remotion/package-lock.json ./remotion/
RUN npm ci --prefix remotion --omit=dev

RUN pip install --no-cache-dir -e . \
    && python -m agent.inventory \
    && python -c "from agent.deep_agent.runner import HARNESS_TOOL_NAMES; assert HARNESS_TOOL_NAMES == {'execute', 'stage_media', 'inspect_media', 'ask_user', 'web_search', 'web_fetch'}"

RUN useradd --create-home --uid 10001 renderhaus \
    && mkdir -p /app/.renderhaus /tmp/renderhaus \
    && chown -R renderhaus:renderhaus /app/.renderhaus /tmp/renderhaus

USER renderhaus

EXPOSE 8080

CMD ["python", "-m", "agent.studio_agent_next"]
