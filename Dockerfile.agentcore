# Amazon Bedrock AgentCore requires linux/arm64.
FROM --platform=linux/arm64 python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AGENTCORE_RUNTIME=1 \
    RENDERHAUS_AGENT_BACKEND=deepagents \
    RENDERHAUS_MEDIA_DIR=/tmp/renderhaus/media \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY pyproject.toml README.md ./
COPY agent ./agent
COPY providers ./providers
COPY configs ./configs
COPY docs/continuity_qc_benchmark_scores.json ./docs/
COPY server ./server
COPY third_party ./third_party

RUN pip install --no-cache-dir -e . \
    && python -c "import importlib.metadata; from agent.deep_agent.runner import SKILLS_ROOT; from providers.catalog import PROVIDERS; from providers.registry import load_committed_schemas; assert importlib.metadata.version('deepagents') == '0.7.23'; assert len(list(SKILLS_ROOT.glob('*/SKILL.md'))) == 24; assert len(PROVIDERS) == 15; assert sum(len(load_committed_schemas(p)) for p in PROVIDERS) == 113"

EXPOSE 8080

CMD ["python", "-m", "agent.studio_agent_next"]
