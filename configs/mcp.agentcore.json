{
  "mcpServers": {
    "mureka": {
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcps.mureka.server"],
      "env": {
        "MUREKA_API_KEY": "${MUREKA_API_KEY}",
        "MUREKA_API_URL": "${MUREKA_API_URL}",
        "MUREKA_MODEL": "${MUREKA_MODEL}",
        "MUREKA_DRY_RUN": "${MUREKA_DRY_RUN}",
        "RENDERHAUS_MEDIA_DIR": "${ROOT}/${RENDERHAUS_MEDIA_DIR}"
      }
    },
    "seedance": {
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcps.seedance.server"],
      "env": {
        "BYTEPLUS_API_KEY": "${BYTEPLUS_API_KEY}",
        "BYTEPLUS_BASE_URL": "${BYTEPLUS_BASE_URL}",
        "SEEDANCE_MODEL": "${SEEDANCE_MODEL}",
        "SEEDANCE_DRY_RUN": "${SEEDANCE_DRY_RUN}",
        "RENDERHAUS_MEDIA_DIR": "${ROOT}/${RENDERHAUS_MEDIA_DIR}"
      }
    },
    "seedream": {
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcps.seedream.server"],
      "env": {
        "BYTEPLUS_API_KEY": "${BYTEPLUS_API_KEY}",
        "BYTEPLUS_BASE_URL": "${BYTEPLUS_BASE_URL}",
        "SEEDREAM_MODEL": "${SEEDREAM_MODEL}",
        "SEEDREAM_DRY_RUN": "${SEEDREAM_DRY_RUN}",
        "SEEDANCE_DRY_RUN": "${SEEDANCE_DRY_RUN}",
        "RENDERHAUS_MEDIA_DIR": "${ROOT}/${RENDERHAUS_MEDIA_DIR}"
      }
    },
    "gemini-tts": {
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcps.gemini_tts.server"],
      "env": {
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
        "GEMINI_TTS_MODEL": "${GEMINI_TTS_MODEL}",
        "GEMINI_TTS_DRY_RUN": "${GEMINI_TTS_DRY_RUN}",
        "RENDERHAUS_MEDIA_DIR": "${ROOT}/${RENDERHAUS_MEDIA_DIR}"
      }
    }
  }
}
