[
  {
    "name": "text_to_video",
    "description": "Generate a Ray 3.2 clip from text. Returns a queued job_id; poll get_video_task until terminal. Outputs are not training eligible.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "Must contain 1 to 6000 characters."
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Allowed values: 5, 10."
        },
        "aspect_ratio": {
          "type": "string",
          "description": "Allowed values: 9:16, 3:4, 1:1, 4:3, 16:9, 21:9."
        },
        "resolution": {
          "type": "string",
          "description": "Allowed values: 360p, 540p, 720p, 1080p."
        },
        "model": {
          "type": "string",
          "description": "Allowed values: ray-3.2."
        }
      },
      "required": [
        "prompt"
      ]
    }
  },
  {
