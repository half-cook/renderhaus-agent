[
  {
    "name": "render_timeline",
        "description": "Compose generated image, video, and audio clips into one final MP4, then poll get_render_progress.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "visuals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "audio_tracks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "aspect_ratio": {
          "type": "string",
          "description": "One of: 16:9, 9:16, 1:1."
        },
        "fps": {
          "type": "integer"
        },
        "output_filename": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "visuals"
      ]
    }
  },
  {
    "name": "get_render_progress",
        "description": "Poll a Remotion render once. Repeat until status is succeeded, failed, or dry_run.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "render_id": {
          "type": "string"
        },
        "bucket_name": {
          "type": "string"
        },
        "output_key": {
          "type": "string"
        },
        "download": {
          "type": "boolean"
        }
      },
      "required": [
        "render_id",
        "bucket_name"
      ]
    }
  }
]
