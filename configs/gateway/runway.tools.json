    "inputSchema": {
      "type": "object",
      "properties": {
        "image_path_or_url": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Allowed range: 2 to 10."
        },
        "ratio": {
          "type": "string",
          "description": "Allowed values: 1280:720, 720:1280, 1104:832, 960:960, 832:1104, 1584:672."
        },
        "model": {
          "type": "string",
          "description": "Allowed values: gen4.5."
        },
        "seed": {
          "type": "integer",
          "description": "Allowed range: 0 to 4.29497e+09."
        }
      },
      "required": [
