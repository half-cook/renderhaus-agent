[
  {
    "name": "text_to_video",
    "description": "Generate a Wan VACE clip from text. Returns job_id; poll get_video_task with download=true until terminal.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "description": "Allowed values: fal-ai/wan-vace-14b, fal-ai/wan-22-vace-fun-a14b."
        },
        "num_frames": {
          "type": "integer",
          "description": "Allowed range: 81 to 241."
        },
        "frames_per_second": {
          "type": "integer",
          "description": "Allowed range: 5 to 30."
        },
        "resolution": {
          "type": "string",
          "description": "Allowed values: auto, 240p, 360p, 480p, 580p, 720p."
        },
        "aspect_ratio": {
          "type": "string",
          "description": "Allowed values: auto, 16:9, 1:1, 9:16."
        },
        "negative_prompt": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        }
      },
      "required": [
        "prompt"
      ]
    }
  },
