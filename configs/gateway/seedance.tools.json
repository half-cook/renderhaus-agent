[
  {
    "name": "text_to_video",
    "description": "Use when the user needs a new video clip from text and no source image must be preserved. Returns a queued task id; follow with get_video_task until terminal.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Allowed range: 4 to 12."
        },
        "aspect_ratio": {
          "type": "string",
          "description": "Allowed values: adaptive, 16:9, 9:16, 1:1, 4:3, 3:4, 21:9."
        },
        "resolution": {
          "type": "string",
          "description": "Allowed values: 480p, 720p, 1080p."
        },
        "model": {
          "type": "string"
        },
        "watermark": {
          "type": "boolean"
        },
        "generate_audio": {
          "type": "boolean"
        },
        "service_tier": {
          "type": "string",
          "description": "One of: default, flex. Allowed values: default, flex."
        }
      },
      "required": [
        "prompt"
      ]
    }
  },
  {
    "name": "image_to_video",
    "description": "Use when the user wants an existing image animated into a video clip. Requires an image URL and returns a queued task id; follow with get_video_task until terminal.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "image_path_or_url": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Allowed range: 4 to 12."
        },
        "aspect_ratio": {
          "type": "string",
          "description": "Allowed values: adaptive, 16:9, 9:16, 1:1, 4:3, 3:4, 21:9."
        },
        "resolution": {
          "type": "string",
          "description": "Allowed values: 480p, 720p, 1080p."
        },
        "model": {
          "type": "string"
        },
        "watermark": {
          "type": "boolean"
        },
        "generate_audio": {
          "type": "boolean"
        },
        "service_tier": {
          "type": "string",
          "description": "One of: default, flex. Allowed values: default, flex."
        }
      },
      "required": [
        "image_path_or_url",
        "prompt"
      ]
    }
  },
  {
    "name": "get_video_task",
    "description": "Use only after text_to_video or image_to_video returned a task id. Poll once per call until succeeded, failed, cancelled, or dry_run; it does not create a new video.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        },
        "download": {
          "type": "boolean"
        }
      },
      "required": [
        "job_id"
      ]
    }
  },
  {
    "name": "list_seedance_models",
    "description": "Use only when model selection or availability is relevant; it does not generate media. Prefer the configured default for ordinary video requests.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  }
]
