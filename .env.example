# Canvas environment — see CLAUDE.md "Environment" and design/merge-doc.md §1.
# Copy to .env.local and fill in real values; .env.local is gitignored.

DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/renderhaus_canvas
# Separate disposable database — tests write rows and must never point at DATABASE_URL's target.
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/renderhaus_canvas_test
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Local identity when Clerk is unconfigured.
RENDERHAUS_DEV_USER=local

# Provider dry-run flags — keep true until Gate 1 of the verification appendix is cleared.
SEEDANCE_DRY_RUN=true
SEEDREAM_DRY_RUN=true
MUREKA_DRY_RUN=true
FISH_AUDIO_DRY_RUN=true
