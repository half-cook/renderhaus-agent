      "abstract_tool": "wan_i2v"
    },
    {
      "pattern": "kling.*(image|i2v)|(image|i2v).*kling|animate.*product photo",
      "skill": "i2v",
      "abstract_tool": "kling_i2v"
    },
    {
      "pattern": "animat|image to video|\\bi2v\\b|first.*last frame",
      "skill": "i2v",
      "abstract_tool": "wan_i2v"
    },
    {
      "pattern": "runway.*(video|gen.?4)|gen.?4.?5",
      "skill": "t2v",
      "abstract_tool": "runway_gen45_t2v"
    },
    {
      "pattern": "seedance",
      "skill": "t2v",
      "abstract_tool": "seedance_t2v"
    },
    {
      "pattern": "kling|cinematic drone",
      "skill": "t2v",
