  "rules": [
    {
      "pattern": "still.*approval.*animat|still.*then.*animat",
      "skill": "still-then-video",
      "abstract_tool": "seedream_t2i"
    },
    {
      "pattern": "runway.*(image to video|i2v)|(image to video|i2v).*runway",
      "skill": "i2v",
      "abstract_tool": "runway_i2v"
    },
    {
      "pattern": "(runway|gen.?4).*image",
      "skill": "product-images",
      "abstract_tool": "runway_gen4_t2i"
    },
    {
      "pattern": "seedream|generate.*(still|image)|product still",
      "skill": "product-images",
      "abstract_tool": "seedream_t2i"
    },
    {
      "pattern": "reject.*training|training.*reject",
      "skill": "continuity-qc",
      "abstract_tool": "wan_t2v"
    },
    {
      "pattern": "\\bqc\\b|consistency|continuity|face drift",
      "skill": "continuity-qc",
      "abstract_tool": "local_qc"
    },
    {
      "pattern": "act.two|performance capture|acting take",
      "skill": "act-two",
      "abstract_tool": "runway_act_two"
    },
    {
      "pattern": "lipsync|lip.sync|talking head|talking avatar|spokesperson|avatar.*(say|script)|elevenlabs then.*infinitetalk",
      "skill": "lipsync",
      "abstract_tool": "infinitetalk_lipsync"
    },
    {
      "pattern": "upscale|interpolate frames",
      "skill": "upscale",
      "abstract_tool": "seedvr2_upscale"
    },
    {
      "pattern": "\\bveo\\b|highest quality.*audio",
      "skill": "veo-t2v",
      "abstract_tool": "veo_t2v"
    },
    {
      "pattern": "(remotion|lower thirds?|kinetic titles)",
      "skill": "motion-graphics",
      "abstract_tool": "remotion_render"
    },
    {
      "pattern": "ideogram",
      "skill": "motion-graphics",
      "abstract_tool": "ideogram_t2i"
    },
    {
      "pattern": "recraft|vector brand",
      "skill": "motion-graphics",
      "abstract_tool": "recraft_t2i"
    },
    {
      "pattern": "text in image",
      "skill": "still-then-video",
      "abstract_tool": "ideogram_t2i"
    },
    {
      "pattern": "rough cut",
      "skill": "resolve-rough-cut",
      "abstract_tool": "edl_export"
    },
    {
      "pattern": "remove silences",
      "skill": "resolve-silence-cut",
      "abstract_tool": "edl_export"
    },
    {
      "pattern": "auto captions",
      "skill": "resolve-auto-subs",
      "abstract_tool": "fcpxml_export"
    },
    {
      "pattern": "import editor|roundtrip",
      "skill": "resolve-roundtrip",
      "abstract_tool": "fcpxml_export"
    },
    {
      "pattern": "without touching grade",
      "skill": "resolve-new-track-safety",
      "abstract_tool": "otio_export"
    },
    {
      "pattern": "free resolve|fcpxml",
      "skill": "resolve-handoff",
      "abstract_tool": "fcpxml_export"
    },
    {
      "pattern": "\\bedl\\b",
      "skill": "resolve-handoff",
      "abstract_tool": "edl_export"
    },
    {
      "pattern": "zip media|conform|package media",
      "skill": "resolve-handoff",
      "abstract_tool": "media_package"
    },
    {
      "pattern": "export.*(resolve|project|timeline)|\\botio\\b|handoff",
      "skill": "resolve-handoff",
      "abstract_tool": "otio_export"
    },
    {
      "pattern": "mmaudio|foley|video to audio|synchronized sfx",
      "skill": "audio-bed",
      "abstract_tool": "mmaudio_sfx"
    },
    {
      "pattern": "ace.step|music bed",
      "skill": "audio-bed",
      "abstract_tool": "ace_step_music"
    },
    {
      "pattern": "elevenlabs|narrat",
      "skill": "audio-bed",
      "abstract_tool": "elevenlabs_tts"
    },
    {
      "pattern": "fish audio",
      "skill": "audio-bed",
      "abstract_tool": "fish_audio_tts"
    },
    {
      "pattern": "luma",
      "skill": "edit-v2v",
      "abstract_tool": "luma_ray3_modify"
    },
    {
      "pattern": "aleph|restyle.*footage",
      "skill": "edit-v2v",
      "abstract_tool": "runway_aleph_edit"
    },
    {
      "pattern": "masked|vace|edit.*(video|footage)|swap.*product",
      "skill": "edit-v2v",
